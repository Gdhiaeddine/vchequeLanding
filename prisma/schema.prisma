generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int           @id @default(autoincrement())
  name                      String
  email                     String        @unique
  email_verified_at         DateTime?
  password                  String
  two_factor_secret         String?
  two_factor_recovery_codes String?
  two_factor_confirmed_at   DateTime?
  remember_token            String?
  created_at                DateTime?     @default(now())
  updated_at                DateTime?     @updatedAt

  app_releases              AppRelease[]
  demo_videos               DemoVideo[]
  blog_posts                BlogPost[]

  @@map("users")
}

model Order {
  id                   Int       @id @default(autoincrement())
  reference            String    @unique
  nom                  String
  email                String
  entreprise           String?
  telephone            String?
  adresse              String?
  code_postal          String?
  ville                String?
  wilaya               String?
  amount               Float
  currency             String    @default("DZD")
  status               String    @default("pending")
  slickpay_invoice_id  String?
  slickpay_payment_url String?
  license_key          String?
  paid_at              DateTime?
  metadata             String?
  created_at           DateTime? @default(now())
  updated_at           DateTime? @updatedAt

  license              License?  @relation(fields: [license_key], references: [license_key])

  @@map("orders")
}

model License {
  id                 Int                 @id @default(autoincrement())
  license_key        String              @unique
  licensee_name      String
  licensee_email     String
  company            String?
  edition            String              @default("COMMERCIAL")
  max_activations    Int                 @default(1)
  status             String              @default("active")
  current_machine_id String?
  notes              String?
  created_at         DateTime?           @default(now())
  updated_at         DateTime?           @updatedAt

  activations        LicenseActivation[]
  audit_logs         LicenseAuditLog[]
  orders             Order[]

  @@map("licenses")
}

model LicenseActivation {
  id             Int       @id @default(autoincrement())
  license_id     Int
  machine_id     String
  machine_name   String?
  os_info        String?
  ip_address     String?
  status         String    @default("active")
  activated_at   DateTime  @default(now())
  deactivated_at DateTime?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt

  license        License   @relation(fields: [license_id], references: [id], onDelete: Cascade)

  @@map("license_activations")
}

model LicenseAuditLog {
  id         Int       @id @default(autoincrement())
  license_id Int
  action     String
  actor      String    @default("SYSTEM")
  ip_address String?
  details    String?
  created_at DateTime? @default(now())

  license    License   @relation(fields: [license_id], references: [id], onDelete: Cascade)

  @@map("license_audit_logs")
}

model AppRelease {
  id             Int       @id @default(autoincrement())
  version        String
  filename       String
  storage_path   String
  file_size      Int
  mime_type      String    @default("application/x-msdownload")
  sha256         String?
  download_count Int       @default(0)
  is_active      Boolean   @default(false)
  release_notes  String?
  uploaded_by    Int?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt

  uploader       User?     @relation(fields: [uploaded_by], references: [id])

  @@map("app_releases")
}

model ContactMessage {
  id           Int       @id @default(autoincrement())
  name         String
  email        String
  phone        String?
  company      String?
  subject_type String    @default("autre")
  subject      String
  message      String
  ip_address   String?
  status       String    @default("unread")
  created_at   DateTime? @default(now())
  updated_at   DateTime? @updatedAt

  @@map("contact_messages")
}

model DemoVideo {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  filename       String
  storage_path   String
  mime_type      String    @default("video/mp4")
  file_size      Int
  thumbnail_path String?
  views_count    Int       @default(0)
  is_active      Boolean   @default(false)
  uploaded_by    Int?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @updatedAt

  uploader       User?     @relation(fields: [uploaded_by], references: [id])

  @@map("demo_videos")
}

model BlogPost {
  id               Int       @id @default(autoincrement())
  title            String
  slug             String    @unique
  excerpt          String?
  content          String
  cover_image_path String?
  category         String    @default("conseils")
  reading_time     Int       @default(3)
  status           String    @default("published")
  published_at     DateTime?
  views_count      Int       @default(0)
  author_id        Int?
  created_at       DateTime? @default(now())
  updated_at       DateTime? @updatedAt

  author           User?     @relation(fields: [author_id], references: [id])

  @@map("blog_posts")
}
